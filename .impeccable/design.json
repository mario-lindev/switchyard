  "narrative": {
    "northStar": "The Bright Engineering Instrument",
    "overview": "A bright engineering instrument: paper-white work surfaces, a graphite navigation rail, vermilion actions, green healthy telemetry, and precise hairlines. The existing visual world is practical, calm, and dense enough for an engineer to operate a release rehearsal without losing the relationship between controls and outcomes.\n\nThe light topology is the signature spatial element. Small service cards, measured values, and moving request markers connect a flag decision to a visible failure or recovery. All traffic, service metrics, latencies, and failures are synthetic; a connected Flagsmith API supplies real flag decisions. Connection and simulation labels are part of the interface's visual truth.",
    "keyCharacteristics": [
      "Light work surfaces framed by graphite navigation.",
      "Restrained vermilion actions with semantic health and failure states.",
      "Readable UI type paired with monospaced code and measured data.",
      "Compact operational controls and a responsive service topology."
    ],
    "rules": [
      {
        "name": "The Evidence Rule",
        "body": "Connection state identifies the flag source; it never changes the synthetic nature of traffic or telemetry.",
        "section": "colors"
      }
    ],
    "dos": [
      "Do use the primary token for the main run action and keyboard focus.",
      "Do use secondary-text for recurring readable metadata; preserve the separate muted token only where the current implementation uses it.",
      "Do pair service colors with status text, icons, or labels.",
      "Do preserve the synthetic-traffic disclosure alongside connection state.",
      "Do keep mobile flag controls before the topology, with telemetry below the controls and service view.",
      "Do respect reduced-motion preferences while preserving the underlying controls and status information."
    ],
    "donts": [
      "Don't describe simulated topology or telemetry as production infrastructure.",
