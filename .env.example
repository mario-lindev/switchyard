# Browser sandbox works without any Flagsmith keys.
PORT=3001
HOST=127.0.0.1
# Official combined Flagsmith API/frontend image. Pin a release for reproducible deployments.
FLAGSMITH_IMAGE=docker.flagsmith.com/flagsmith/flagsmith:latest
# Set your own LOCAL LAB secrets before starting Docker. Do not commit .env.
POSTGRES_PASSWORD=replace-with-a-local-lab-password
DJANGO_SECRET_KEY=replace-with-a-random-local-lab-secret-at-least-32-characters
WAREHOUSE_CREDENTIALS_SECRET=replace-with-another-random-local-lab-secret
# For npm run dev, localhost is correct. Compose overrides this to the flagsmith service.
FLAGSMITH_API_URL=http://localhost:8000/api/v1/
FLAGSMITH_ENVIRONMENT_KEY=
# Environment API key used by the admin API URL, distinct from server-side SDK key.
FLAGSMITH_ENVIRONMENT_ID=
FLAGSMITH_MANAGEMENT_TOKEN=
FLAGSMITH_PROJECT_ID=
FLAGSMITH_ENVIRONMENT_LABEL=Switchyard lab
# Enables only the three allowlisted flags. Use a dedicated lab environment.
ALLOW_FLAG_MUTATIONS=false
